{
  "name": "qa-suite-api-e2e",
  "version": "1.0.0",
  "description": "Suite de pruebas API (JSONPlaceholder) y E2E (SauceDemo) con Playwright + Allure",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:html": "playwright show-report",
    "report:md": "node scripts/generate-report.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
